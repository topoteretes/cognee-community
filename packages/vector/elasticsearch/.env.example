LLM_API_KEY=YOUR_OPENAI_API_KEY

VECTOR_DB_PROVIDER=elasticsearch
# One or more node URLs, comma-separated. Leave empty when using ELASTICSEARCH_CLOUD_ID.
VECTOR_DB_URL=http://localhost:9200
# Elasticsearch API key: the encoded value the API returns, or "<id>:<api_key>".
VECTOR_DB_KEY=
# Alternatively, HTTP basic auth (ignored when VECTOR_DB_KEY is set).
VECTOR_DB_USERNAME=
VECTOR_DB_PASSWORD=
VECTOR_DATASET_DATABASE_HANDLER=elasticsearch

# --- Optional ---
# Elastic Cloud deployment id; replaces VECTOR_DB_URL.
#ELASTICSEARCH_CLOUD_ID=
# Prefix of every index the adapter manages (default: cognee).
#ELASTICSEARCH_INDEX_PREFIX=cognee
# TLS settings for self-signed clusters.
#ELASTICSEARCH_VERIFY_CERTS=true
#ELASTICSEARCH_CA_CERTS=/path/to/http_ca.crt
# index_options of new indices: int8_hnsw (default), hnsw, int4_hnsw, bbq_hnsw, a JSON
# object such as {"type": "hnsw", "m": 32}, or "server" for the server's default.
#ELASTICSEARCH_INDEX_OPTIONS=int8_hnsw
