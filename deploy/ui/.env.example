# Copy to .env and fill in. Read only by the UI stack (docker-compose.yml here).

# ---- Backend ----------------------------------------------------------------
# The cognee API as the BROWSER reaches it: scheme + host (+ port), no path.
# Both the browser and the UI container call it, so use the reverse proxy's
# public hostname, not host.docker.internal or 127.0.0.1.
#
# Recommended: one hostname for UI and API, proxy routes /api/v1/ to the cognee
# nodes and everything else to this UI (the UI has its own /api/* routes, so do
# not forward all of /api/). Then this is the same URL users open, no CORS
# preflights, and the SameSite=Lax login cookie works as is:
#   COGNEE_BACKEND_URL=https://cognie.example.com
#   CORS_ALLOWED_ORIGINS=https://cognie.example.com     (in ../.env)
#
# Split hostnames (app.example.com + api.example.com) also work, but only when
# both share a registrable domain: the API sets its cookie SameSite=Lax, so a
# UI on a different domain can never log in. CORS_ALLOWED_ORIGINS then lists
# the UI's origin, not the API's.
COGNEE_BACKEND_URL=https://cognie.example.com

# ---- Login ------------------------------------------------------------------
# Users sign in on the UI's login page with the accounts created under "First
# user" in ../README.md (the form is prefilled with upstream's dev defaults;
# just overwrite them). Do NOT add DEFAULT_USER_PASSWORD here: the UI's server
# routes for graph/schema views log in as the default superuser whenever the
# browser sends no session, which would hand that access to anyone who can
# reach port 3000.

# ---- Image ------------------------------------------------------------------
# Same upstream release as the API (COGNEE_VERSION in ../.env).
#COGNEE_UI_VERSION=1.6.1

# ---- Networking -------------------------------------------------------------
# Loopback by default, for a reverse proxy on this host. 172.17.0.1 if the
# proxy itself is a container; 0.0.0.0 exposes the UI directly.
#UI_BIND_ADDRESS=127.0.0.1
#UI_PORT=3000
#UI_CPUS=1.0
#UI_MEMORY=1g
