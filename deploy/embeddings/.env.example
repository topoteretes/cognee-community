# Copy to .env. Defaults work as they are.

# Any sentence-embedding model on Hugging Face. Keep EMBEDDING_MODEL /
# EMBEDDING_DIMENSIONS in deploy/.env in sync (e5-base = 768 dims).
#TEI_MODEL=intfloat/multilingual-e5-base

# TEI uses every core it is given; this is the knob for ingestion speed.
#TEI_CPUS=4.0
#TEI_MEMORY=3g

# Interface/port published on the host. Default is the Docker bridge gateway,
# reachable from containers on this host as host.docker.internal.
#TEI_BIND_ADDRESS=172.17.0.1
#TEI_PORT=8080

# Model cache folder (TEI runs as root, no chown needed).
#DATA_DIR=./data
#TEI_VERSION=cpu-1.9
