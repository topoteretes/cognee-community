# Salesforce Connected App OAuth 2.0 Credentials
SALESFORCE_INSTANCE_URL=https://your-instance.my.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret
SALESFORCE_REFRESH_TOKEN=your_oauth_refresh_token

# Optional: Username-Password Flow (Developer Edition or Sandbox)
SALESFORCE_USERNAME=developer@example.com
SALESFORCE_PASSWORD=your_password
SALESFORCE_SECURITY_TOKEN=your_security_token
SALESFORCE_AUTH_URL=https://login.salesforce.com

# Cognee Configuration
LLM_API_KEY=your_openai_api_key
