# Local Ollama inference. "ollama" is a placeholder, not a cloud credential.
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b-instruct
LLM_ENDPOINT=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MAX_COMPLETION_TOKENS=4096
LLM_INSTRUCTOR_MODE=json_schema_mode
LLM_ARGS='{"temperature":0}'
LOGROCKET_COGNEE_E2E_TIMEOUT=900

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=all-minilm
EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_COMPLETION_TOKENS=256
MOCK_EMBEDDING=false

# Use cached tokenizers or Cognee's tokenizer fallback; no Hugging Face downloads.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
