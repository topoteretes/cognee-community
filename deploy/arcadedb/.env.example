# Copy to .env.

# ---- Root password ----------------------------------------------------------
# NOT set here. It lives in a file (default ./root_password, git-ignored) that
# the `init` service stages for uid 1000 and ArcadeDB reads at start, so it never
# appears on the JVM command line or in `docker inspect`. No chown needed:
#   (umask 077 && openssl rand -base64 24 > root_password)
# Min 8 characters. The same value goes into deploy/.env as
# GRAPH_DATABASE_PASSWORD. Changing the file takes effect on the next
# `docker compose up -d` (the container is recreated and root re-created).
#ARCADEDB_ROOT_PASSWORD_FILE=./root_password

# Host folder for databases/, backups/, log/ and certs/. Created by Docker on
# first start and chowned to uid 1000 by the `init` service.
#DATA_DIR=./data

# Interface the HTTP (2480), HTTPS (2490) and Bolt (7687) ports are published
# on. Default is the Docker bridge gateway: reachable from containers on this
# host as host.docker.internal, not from the network. 0.0.0.0 to serve other
# hosts.
#ARCADEDB_BIND_ADDRESS=172.17.0.1

# Studio (web UI at http://<host>:2480/, root login). Production mode disables
# it unless forced on; it is static content behind the same auth as the API.
#ARCADEDB_STUDIO_ENABLED=true

# ---- TLS (off by default) ---------------------------------------------------
# Not needed while everything runs on this host: the ports are only published
# on the bridge gateway. Enable it when ARCADEDB_BIND_ADDRESS=0.0.0.0, i.e.
# when a cognee node on another machine must reach this server.
#
# KNOWN LIMIT: the cognee ArcadeDB adapter (this repo) talks plain http:// on
# 2480 and bolt:// on 7687 and has no TLS option yet, so enabling TLS here
# protects Studio/other clients but not cognee's own traffic. For a cross-host
# cognee today put the hosts on a private network (WireGuard/Tailscale/VPC)
# and keep ARCADEDB_BIND_ADDRESS on that interface.
#
# 1. Put a PKCS12 keystore with the server certificate + key in
#    $DATA_DIR/certs/keystore.p12, readable by uid 1000. Self-signed:
#      docker run --rm -v "$PWD/data/certs:/certs" --entrypoint keytool \
#        arcadedata/arcadedb:26.10.1 -genkeypair -alias arcadedb -keyalg RSA \
#        -keysize 2048 -validity 825 -storetype PKCS12 -storepass changeit \
#        -keystore /certs/keystore.p12 -dname "CN=arcadedb" \
#        -ext "SAN=dns:arcadedb.example.com,ip:10.0.0.5"
#    From an existing PEM cert/key (e.g. Let's Encrypt):
#      openssl pkcs12 -export -in fullchain.pem -inkey privkey.pem \
#        -name arcadedb -passout pass:changeit -out data/certs/keystore.p12
# 2. Uncomment (one line). The trust store is required by the Bolt listener;
#    pointing it at the same keystore is fine for server-only TLS.
#    arcadedb.bolt.ssl: REQUIRED (TLS only) or OPTIONAL (TLS or plaintext).
#    HTTPS answers on 2490; plain HTTP on 2480 stays on (Studio, healthcheck).
#ARCADEDB_TLS_SETTINGS=-Darcadedb.ssl.enabled=true -Darcadedb.ssl.keyStore=/home/arcadedb/certs/keystore.p12 -Darcadedb.ssl.keyStorePassword=changeit -Darcadedb.ssl.trustStore=/home/arcadedb/certs/keystore.p12 -Darcadedb.ssl.trustStorePassword=changeit -Darcadedb.bolt.ssl=OPTIONAL

# ---- Sizing -----------------------------------------------------------------
# default | low-ram | low-cpu | high-performance (4+ cores, 8+ GB)
#ARCADEDB_PROFILE=default

# CPU scales with concurrent ingestion, memory with the number of open tenant
# databases. The JVM heap is 75% of the memory limit.
#ARCADEDB_CPUS=4.0
#ARCADEDB_MEMORY=4g

#ARCADEDB_VERSION=26.10.1
