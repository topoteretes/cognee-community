# TypeDB graph store (TypeDB 3.12+; defaults shown)
GRAPH_DATABASE_PROVIDER=typedb
# One TypeDB database per dataset when backend access control is on (the default).
GRAPH_DATASET_DATABASE_HANDLER=typedb
GRAPH_DATABASE_URL=127.0.0.1:1729
GRAPH_DATABASE_USERNAME=admin
GRAPH_DATABASE_PASSWORD=password
# Using the bundled compose file instead? It listens on host port 1730:
#GRAPH_DATABASE_URL=127.0.0.1:1730

# TLS (TypeDB Cloud, hardened servers). Off by default.
#TYPEDB_TLS=true
# PEM CA bundle for a private / self-signed CA; system trust roots otherwise.
#TYPEDB_TLS_ROOT_CA=/path/to/ca.pem

# LLM (cognee defaults to OpenAI; only the key is required)
LLM_API_KEY=your_api_key

# Alternative: Anthropic for the LLM + local fastembed embeddings (no embedding key).
# Requires the `llm` extra: `uv sync --extra llm` (or `pip install '...[llm]'`).
#LLM_PROVIDER=anthropic
#LLM_MODEL=anthropic/claude-opus-5
#EMBEDDING_PROVIDER=fastembed
#EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#EMBEDDING_DIMENSIONS=384
#EMBEDDING_MAX_COMPLETION_TOKENS=512

# Only needed if you do NOT want per-dataset databases.
#ENABLE_BACKEND_ACCESS_CONTROL=false
