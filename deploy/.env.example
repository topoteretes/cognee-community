# Copy to .env and fill in. Shared by the query node (docker-compose.yml) and
# the ingest node (docker-compose.ingest.yml): docker compose interpolates
# ${...} in both files from it AND passes every line to both cognee
# containers, so any cognee setting (cognee's .env.template) works here.
#
# Generate secrets with:  openssl rand -hex 32

# ---- Storage: S3-compatible bucket ------------------------------------------
# Uploaded files and both nodes' system files live in one bucket (AWS S3,
# MinIO, ...): s3://<bucket>/data, /system/query, /system/ingest, /cognee/cache.
# Create the bucket and a dedicated access key first; cognee creates neither.
# The compose files derive STORAGE_BACKEND, DATA_ROOT_DIRECTORY and the per-node
# SYSTEM_ROOT_DIRECTORY from the bucket name. Databases are NOT in S3.
STORAGE_BUCKET_NAME=cognee
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Non-AWS S3 only. MinIO on this host, published on the Docker bridge gateway;
# or its HTTPS hostname behind the reverse proxy, which also works from other
# hosts (change only this line when a node moves).
AWS_ENDPOINT_URL=http://host.docker.internal:9005

# ---- cognee runtime ---------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
# Multi-tenancy: per-user/per-dataset isolation, every endpoint needs a login.
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true

# ---- Relational store: external PostgreSQL ----------------------------------
# Not part of this stack. Any PostgreSQL 14+ whose role/database already exist,
# e.g. deploy/postgres-ssl on this host. host.docker.internal is this host as
# seen from inside the container; use a hostname/IP for a remote server.
DB_PROVIDER=postgres
DB_HOST=host.docker.internal
DB_PORT=5405
DB_USERNAME=cognee
DB_PASSWORD=
DB_NAME=cognee_db
# asyncpg negotiates TLS automatically when the server offers it; to require
# it (the postgres-ssl cert is self-signed for "localhost", so no verify-*):
#DATABASE_CONNECT_ARGS='{"ssl": "require"}'

# ---- Graph + vector store: ArcadeDB (deploy/arcadedb stack) -----------------
# Not part of this stack. host.docker.internal is this host as seen from the
# container (the arcadedb stack publishes on the Docker bridge gateway); use a
# hostname/IP for a remote server. The adapter always talks HTTP on 2480 and
# Bolt on 7687 on that host. Root credentials are required: cognee creates one
# ArcadeDB database per dataset, a server-level operation.
# GRAPH_DATABASE_PASSWORD = the contents of arcadedb/root_password.
GRAPH_DATABASE_PROVIDER=arcadedb
GRAPH_DATABASE_URL=http://host.docker.internal:2480
GRAPH_DATABASE_USERNAME=root
GRAPH_DATABASE_PASSWORD=
GRAPH_DATASET_DATABASE_HANDLER=arcadedb_graph_local
VECTOR_DB_PROVIDER=arcadedb
VECTOR_DB_URL=http://host.docker.internal:2480
VECTOR_DATASET_DATABASE_HANDLER=arcadedb_vector_local

# ---- API security -----------------------------------------------------------
# Token signing secrets. Must be stable across restarts and are shared by both
# nodes through this file, so a token from one node is valid on the other.
FASTAPI_USERS_JWT_SECRET=
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=
# Browser origins allowed to call the API. Comma-separated, no wildcard. With
# the web UI (ui/) this is the origin users open the UI on.
CORS_ALLOWED_ORIGINS=https://cognie.example.com

# ---- LLM / embeddings -------------------------------------------------------
LLM_API_KEY=
#LLM_PROVIDER=openai
#LLM_MODEL=openai/gpt-5.6-luna
#LLM_ENDPOINT=
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=openai/text-embedding-3-large
#EMBEDDING_DIMENSIONS=3072
#EMBEDDING_API_KEY=
#
# Local embeddings, option A: in-process fastembed (ONNX, CPU, built into
# cognee; model downloads once per node into the fastembed_cache volume, uses
# each node's own CPUs). Choose the model BEFORE ingesting: changing it later
# means re-cognifying every dataset. cognee embeds with no query/passage
# prefixes, so prefer models that need none (BGE v1.5, jina v2, gte); e5,
# nomic and arctic expect prefixes and lose quality here.
# IMPORTANT: cognee sizes chunks from EMBEDDING_MAX_COMPLETION_TOKENS (default
# 8191) and fastembed silently truncates to the model's window, so with a
# 512-token model and the default, every chunk beyond its first 512 tokens is
# invisible to search. Always set it to the model's window.
#EMBEDDING_PROVIDER=fastembed
# English (+ source code): bge-base-en-v1.5, 768 dims, 512-token window.
# bge-small-en-v1.5 (384 dims) is ~3x faster with lower retrieval quality.
#EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
#EMBEDDING_DIMENSIONS=768
#EMBEDDING_MAX_COMPLETION_TOKENS=500
# Long chunks (fewer, larger LLM extraction calls): jinaai/jina-embeddings-v2-base-en
# (768 dims, 8192 window, slower per chunk on CPU) with
# EMBEDDING_MAX_COMPLETION_TOKENS=2048. Multilingual: jinaai/jina-embeddings-v3
# (1024 dims, 2.3 GB).
#
# Local embeddings, option B: the deploy/embeddings stack (text-embeddings-
# inference, CPU), one server for both nodes, reached through its
# OpenAI-compatible /v1/embeddings endpoint.
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=openai/intfloat/multilingual-e5-base
#EMBEDDING_ENDPOINT=http://host.docker.internal:8080/v1
#EMBEDDING_API_KEY=local
#EMBEDDING_DIMENSIONS=768
# Chunk budget below the model's 512-token limit: cognee counts tokens with
# TikToken for this provider, which undercounts for non-English text.
#EMBEDDING_MAX_COMPLETION_TOKENS=400
# Required: cognee forwards `dimensions` on every OpenAI-style embedding call
# and litellm rejects it for non-OpenAI model names unless told to drop it.
#LITELLM_DROP_PARAMS=true

# ---- Bootstrap admin (optional) --------------------------------------------
# cognee creates a password-less superuser on first start. Setting a password
# here gives it one ONCE (never changes an existing password) so you can log in
# and create tenants/users. Remove both lines after the first boot.
#DEFAULT_USER_EMAIL=admin@example.com
#DEFAULT_USER_PASSWORD=

# ---- Networking -------------------------------------------------------------
# Where the two APIs are published on the host. Keep loopback and front them
# with a TLS reverse proxy that sends /api/v1/add, /cognify, /remember, /memify
# and /update to the ingest port and everything else to the query port
# (172.17.0.1 if the proxy itself is a container; 0.0.0.0 exposes directly).
#COGNEE_BIND_ADDRESS=127.0.0.1
#QUERY_PORT=8000
#INGEST_PORT=8001

# ---- Image / versions -------------------------------------------------------
# Both nodes run COGNEE_IMAGE:COGNEE_VERSION, the cognee/cognee image plus the
# ArcadeDB adapter, built from deploy/Dockerfile and published to Docker Hub.
# The adapter pins an exact cognee version; the image tag follows it.
#COGNEE_IMAGE=kolosek/cognee-arcadedb
#COGNEE_VERSION=1.6.1
# Local build only (docker-compose.build.yml): ADAPTER_SOURCE accepts a PyPI
# requirement to install a published adapter release instead of this checkout.
#ADAPTER_SOURCE=cognee-community-hybrid-adapter-arcadedb==0.5.0

# ---- Resources --------------------------------------------------------------
# Per-node container limits (ArcadeDB, Postgres and embeddings are sized in
# their own stacks). The query node serves searches: small and steady. The
# ingest node runs cognify: give it the cores, and add 2-4 GB of swap on small
# hosts so a spike pages instead of OOM-killing it.
#QUERY_CPUS=2.0
#QUERY_MEMORY=4g
#INGEST_CPUS=4.0
#INGEST_MEMORY=8g
# Datasets cognified at once on the ingest node (each is mostly waiting on the
# LLM; raise with the LLM rate limit and ArcadeDB headroom).
#INGEST_DATASET_QUEUE_MAX_CONCURRENT=4
#QUERY_DATASET_QUEUE_MAX_CONCURRENT=2

# ---- Multi-tenant tuning (optional) -----------------------------------------
# One ArcadeDB database per dataset: cap how many per-dataset engines each
# node keeps open. Size it above the number of tenants (datasets) active at
# the same time, not the total: below that, every request pays an engine
# open. With one dataset per workspace (agents/README.md) that is the number
# of workspaces with a running task. ArcadeDB heap grows with it too.
#DATABASE_MAX_LRU_CACHE_SIZE=128
#TELEMETRY_DISABLED=1
