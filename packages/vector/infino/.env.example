LLM_API_KEY=YOUR_OPENAI_API_KEY

# Where the memory lives. Infino is embedded, so this is a location, not a
# server: a local directory, or an s3:// prefix for durable memory on object
# storage. Defaults to a directory next to example.py when unset.
#VECTOR_DB_URL=./.infino_storage
#VECTOR_DB_URL=s3://your-bucket/cognee-memory

VECTOR_DATASET_DATABASE_HANDLER=infino
